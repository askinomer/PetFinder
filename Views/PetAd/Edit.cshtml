@model PetFinder.Models.PetAd
@{
    ViewData["Title"] = "Edit Pet Ad";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <h3 class="card-title mb-4"><i class="bi bi-pencil-square"></i> Edit Pet Ad</h3>

                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="All" class="text-danger small mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Species" class="form-label"></label>
                            <select asp-for="Species" class="form-select">
                                <option value="">-- Select --</option>
                                <option value="Cat">Cat</option>
                                <option value="Dog">Dog</option>
                            </select>
                            <span asp-validation-for="Species" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    @if (Model.ImageBytes != null && Model.ImageBytes.Length > 0)
                    {
                        <div class="mb-3 text-center">
                            <p class="small text-muted mb-1">Current image:</p>
                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.ImageBytes)"
                                 alt="current" style="max-height:160px;" class="rounded shadow-sm" />
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Replace photo (optional)</label>
                        <input type="file" name="imageFile" accept="image/*" class="form-control" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save"></i> Update
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
