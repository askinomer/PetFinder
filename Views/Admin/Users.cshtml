@model IEnumerable<PetFinder.Models.User>
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="section-heading mb-0"><i class="bi bi-people"></i> Kullanıcı Yönetimi</h2>
        <a asp-action="Index" class="btn btn-pf-outline btn-sm">
            <i class="bi bi-arrow-left"></i> Panele Dön
        </a>
    </div>

    <div class="card auth-card p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Kullanıcı Adı</th>
                        <th>Rol</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>@u.Id</td>
                            <td><i class="bi bi-person-circle"></i> <strong>@u.Username</strong></td>
                            <td>
                                @if (u.Username == "admin")
                                {
                                    <span class="badge bg-warning text-dark">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Üye</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (u.Username != "admin")
                                {
                                    <form asp-action="DeleteUser" method="post" class="d-inline"
                                          onsubmit="return confirm('@u.Username kullanıcısını silmek istediğine emin misin?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <button class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Sil
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Korumalı</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
