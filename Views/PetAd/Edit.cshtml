@model PetFinder.Models.PetAd
@{
    ViewData["Title"] = "İlanı Düzenle";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card auth-card">
                <div class="card-body p-4">
                    <h3 class="mb-4" style="color:var(--pf-purple-dark);">
                        <i class="bi bi-pencil-square"></i> İlanı Düzenle
                    </h3>

                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="All" class="text-danger small mb-2"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Species" class="form-label"></label>
                                <select asp-for="Species" class="form-select">
                                    <option value="">-- Seçin --</option>
                                    <option value="Köpek">🐕 Köpek</option>
                                    <option value="Kedi">🐈 Kedi</option>
                                </select>
                                <span asp-validation-for="Species" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="City" class="form-label"></label>
                                <input asp-for="City" class="form-control" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        @if (Model.ImageBytes != null && Model.ImageBytes.Length > 0)
                        {
                            <div class="mb-3 text-center">
                                <p class="small text-muted mb-1">Mevcut fotoğraf:</p>
                                <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.ImageBytes)"
                                     alt="mevcut" style="max-height:180px;" class="rounded shadow-sm" />
                            </div>
                        }

                        <div class="mb-4">
                            <label class="form-label">Fotoğrafı değiştir <span class="text-muted small">(isteğe bağlı)</span></label>
                            <input type="file" name="imageFile" accept="image/*" class="form-control" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-pf">
                                <i class="bi bi-save"></i> Güncelle
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
