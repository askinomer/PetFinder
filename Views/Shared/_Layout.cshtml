<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PetFinder TR</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- Top notice bar -->
    <div class="top-notice">
        <div class="container">
            <a href="#">Daha fazla bilgi</a> almak için: PetFinder Türkiye'de barınaklara nasıl destek oluyor?
            <i class="bi bi-chevron-right"></i>
        </div>
    </div>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg pf-navbar">
        <div class="container">
            <a class="navbar-brand" asp-controller="PetAd" asp-action="Index">
                <i class="bi bi-heart-fill" style="color: var(--pf-pink);"></i> petfinder<sub style="font-size:0.55rem; color:#888; text-transform:uppercase;">Türkiye</sub>
            </a>
            <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto ms-4">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#">Hayvan Bul</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="PetAd" asp-action="Index" asp-route-species="Köpek"><i class="bi bi-emoji-smile"></i> Köpekler</a></li>
                            <li><a class="dropdown-item" asp-controller="PetAd" asp-action="Index" asp-route-species="Kedi"><i class="bi bi-emoji-heart-eyes"></i> Kediler</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="PetAd" asp-action="Index">Tüm İlanlar</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#hakkinda">Hakkımızda</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="PetAd" asp-action="Create">
                                <i class="bi bi-plus-circle"></i> Yeni İlan
                            </a>
                        </li>
                        @if (User.Identity.Name == "admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index" style="color:var(--pf-purple) !important;">
                                    <i class="bi bi-speedometer2"></i> Admin Panel
                                </a>
                            </li>
                        }
                    }
                </ul>
                <ul class="navbar-nav align-items-center">
                    <li class="nav-item me-2">
                        <a class="nav-link" href="#"><i class="bi bi-heart" style="font-size:1.3rem;"></i></a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item me-2">
                            <span class="text-muted small">
                                <i class="bi bi-person-circle"></i> @User.Identity.Name
                            </span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-pf-outline btn-sm">Çıkış</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-2">
                            <a asp-controller="Account" asp-action="Register" class="btn btn-pf-outline btn-sm">Kayıt Ol</a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-pf">
                                <i class="bi bi-person"></i> Giriş Yap
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show shadow-sm">
                    <i class="bi bi-check-circle"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="pf-footer" id="hakkinda">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5 class="text-white mb-3"><i class="bi bi-heart-fill" style="color: var(--pf-pink);"></i> petfinder Türkiye</h5>
                    <p class="small mb-0">Türkiye'nin dört bir yanından kayıp dostlarına yuva, sahiplendirmek isteyenlere de yeni en iyi arkadaşlarını bulmaları için bir köprü kuruyoruz.</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h6 class="text-white">Keşfet</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="PetAd" asp-action="Index" asp-route-species="Köpek">Köpekler</a></li>
                        <li><a asp-controller="PetAd" asp-action="Index" asp-route-species="Kedi">Kediler</a></li>
                        <li><a asp-controller="PetAd" asp-action="Index">Tüm İlanlar</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-3">
                    <h6 class="text-white">Hesap</h6>
                    <ul class="list-unstyled small">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li><a asp-controller="PetAd" asp-action="Create">İlan Oluştur</a></li>
                        }
                        else
                        {
                            <li><a asp-controller="Account" asp-action="Login">Giriş Yap</a></li>
                            <li><a asp-controller="Account" asp-action="Register">Kayıt Ol</a></li>
                        }
                    </ul>
                </div>
            </div>
            <hr class="border-light opacity-25 my-3" />
            <p class="text-center small mb-0">&copy; @DateTime.Now.Year PetFinder Türkiye · Kayıp & Sahiplendirme İlanları</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
