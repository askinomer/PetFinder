@model PetFinder.Models.PetAd
@{
    ViewData["Title"] = Model.Name;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card pet-card">
                @if (Model.ImageBytes != null && Model.ImageBytes.Length > 0)
                {
                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.ImageBytes)"
                         class="card-img-top" style="max-height:480px; object-fit:cover;" alt="@Model.Name" />
                }
                else
                {
                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height:300px;">
                        <i class="bi bi-image text-muted" style="font-size:5rem;"></i>
                    </div>
                }
                <div class="card-body p-4">
                    <h2 class="card-title" style="color:var(--pf-purple-dark);">@Model.Name</h2>
                    <div class="mb-3">
                        <span class="badge badge-species fs-6">@Model.Species</span>
                        <span class="badge badge-city fs-6"><i class="bi bi-geo-alt"></i> @Model.City</span>
                    </div>
                    <hr />
                    <h6 class="text-muted text-uppercase small">Açıklama</h6>
                    <p class="card-text" style="white-space: pre-wrap; font-size:1.05rem;">
                        @if (string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <em class="text-muted">Açıklama eklenmemiş.</em>
                        }
                        else
                        {
                            @Model.Description
                        }
                    </p>

                    <div class="d-flex gap-2 mt-4 flex-wrap">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Geri
                        </a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="bi bi-pencil"></i> Düzenle
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Sil
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
