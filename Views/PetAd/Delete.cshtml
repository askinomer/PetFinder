@model PetFinder.Models.PetAd
@{
    ViewData["Title"] = "İlanı Sil";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card auth-card border-danger">
                <div class="card-body p-4">
                    <h3 class="card-title text-danger">
                        <i class="bi bi-exclamation-triangle"></i> Silmeyi Onayla
                    </h3>
                    <p>Aşağıdaki ilanı silmek istediğinize emin misiniz? Bu işlem geri alınamaz.</p>

                    <dl class="row mt-4">
                        <dt class="col-sm-3">İsim</dt>
                        <dd class="col-sm-9">@Model.Name</dd>

                        <dt class="col-sm-3">Tür</dt>
                        <dd class="col-sm-9">@Model.Species</dd>

                        <dt class="col-sm-3">Şehir</dt>
                        <dd class="col-sm-9">@Model.City</dd>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <dt class="col-sm-3">Açıklama</dt>
                            <dd class="col-sm-9 text-muted">@Model.Description</dd>
                        }
                    </dl>

                    @if (Model.ImageBytes != null && Model.ImageBytes.Length > 0)
                    {
                        <div class="text-center mb-3">
                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.ImageBytes)"
                                 alt="@Model.Name" style="max-height:180px;" class="rounded" />
                        </div>
                    }

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Evet, Sil
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
