@model PetFinder.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card auth-card">
                <div class="card-body p-4">
                    <h3 class="card-title text-center mb-4" style="color:var(--pf-purple-dark);">
                        <i class="bi bi-box-arrow-in-right"></i> Giriş Yap
                    </h3>
                    <form asp-action="Login" method="post">
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                        <div asp-validation-summary="All" class="text-danger small mb-2"></div>

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label"></label>
                            <input asp-for="Username" class="form-control" autocomplete="username" placeholder="Kullanıcı adınız" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-pf w-100 py-2">Giriş Yap</button>
                    </form>
                    <p class="text-center text-muted mt-3 mb-0 small">
                        Hesabın yok mu? <a asp-action="Register" style="color:var(--pf-purple);">Kayıt ol</a>
                    </p>
                    <p class="text-center text-muted mt-2 mb-0 small">
                        Demo hesap: <code>admin / admin123</code>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
